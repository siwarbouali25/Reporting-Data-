    "        \"revisions\":      result[\"revision_count\"],\n",
    "        \"approved\":       result[\"judge_result\"].get(\"approved\"),\n",
    "        \"checklist\":      result[\"judge_result\"].get(\"checklist\"),\n",
    "        \"issues\":         result[\"judge_result\"].get(\"main_issues\"),\n",
    "    }, f, indent=2, ensure_ascii=False)\n",
